---
import '../styles/global.css';
import { getSite } from '../lib/site';

const site = await getSite();

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const links = Object.entries(site.links).filter(([, v]) => v);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-line">
      <div class="mx-auto max-w-4xl px-5 py-5 flex items-center justify-between gap-x-6">
        <a href="/" class="font-serif text-xl font-semibold">{site.name}</a>
        <nav class="hidden gap-x-6 text-sm sm:flex">
          {
            site.nav.map((item) => (
              <a
                href={item.href}
                class:list={['hover:text-accent', isActive(item.href) ? 'text-accent font-semibold' : 'text-muted']}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button
          id="nav-toggle"
          type="button"
          class="-mr-2 rounded p-2 text-muted hover:text-accent sm:hidden"
          aria-label="Menu"
          aria-controls="mobile-nav"
          aria-expanded="false"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      </div>
      <nav id="mobile-nav" class="hidden border-t border-line sm:hidden">
        <div class="mx-auto flex max-w-4xl flex-col px-5 py-2">
          {
            site.nav.map((item) => (
              <a
                href={item.href}
                class:list={['py-2.5', isActive(item.href) ? 'text-accent font-semibold' : 'text-muted']}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <slot name="hero" />

    <main class="mx-auto w-full max-w-4xl px-5 py-12 flex-1">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-4xl px-5 py-6 flex flex-wrap justify-between gap-3 text-sm text-muted">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span class="flex flex-wrap gap-4">
          <a href={`mailto:${site.email}`} class="hover:text-accent">Email</a>
          {
            links.map(([k, v]) => (
              <a href={v} class="capitalize hover:text-accent" rel="me noopener">
                {k}
              </a>
            ))
          }
          <a href="/rss.xml" class="hover:text-accent">RSS</a>
        </span>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const btn = document.getElementById('nav-toggle');
        const nav = document.getElementById('mobile-nav');
        btn.addEventListener('click', () => {
          const open = nav.classList.toggle('hidden') === false;
          btn.setAttribute('aria-expanded', String(open));
        });
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) return els.forEach((el) => el.classList.add('in'));
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
