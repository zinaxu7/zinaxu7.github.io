---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title="Blog" description="Notes on research methods, papers, and conferences.">
  <h1 class="text-4xl font-semibold">Blog</h1>
  <p class="mt-3 text-muted">Notes on methods, papers I am reading, and work in progress.</p>
  <ul class="mt-8 divide-y divide-line">
    {
      posts.map((p) => (
        <li class="py-5">
          <time class="text-sm text-muted">{fmt(p.data.pubDate)}</time>
          <h2 class="mt-1 text-2xl font-semibold">
            <a href={`/blog/${p.id}/`} class="hover:text-accent">{p.data.title}</a>
          </h2>
          <p class="mt-2 leading-relaxed">{p.data.description}</p>
          <ul class="mt-2 flex flex-wrap gap-2 text-xs text-muted">
            {p.data.tags.map((t) => <li>#{t}</li>)}
          </ul>
        </li>
      ))
    }
  </ul>
</Base>
