---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <a href="/projects/" class="text-sm text-accent hover:underline">← All projects</a>
  <h1 class="mt-4 text-4xl font-semibold leading-tight">{entry.data.title}</h1>
  <p class="mt-4 font-serif text-xl leading-relaxed text-muted">{entry.data.summary}</p>

  <dl class="mt-8 grid gap-4 rounded-lg border border-line bg-card p-5 text-sm sm:grid-cols-3">
    <div>
      <dt class="text-muted">Role</dt>
      <dd class="mt-1 font-medium">{entry.data.role}</dd>
    </div>
    <div>
      <dt class="text-muted">Period</dt>
      <dd class="mt-1 font-medium">{entry.data.period}</dd>
    </div>
    <div>
      <dt class="text-muted">Methods</dt>
      <dd class="mt-1 font-medium">{entry.data.methods.join(', ')}</dd>
    </div>
  </dl>

  <article class="prose mt-10">
    <Content />
  </article>
</Base>
