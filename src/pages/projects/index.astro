---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// Projects with a `category` are grouped under that heading; the rest go in one unnamed group.
const categories = [...new Set(projects.map((p) => p.data.category ?? ''))];
---

<Base title="Projects" description="Research and design project case studies.">
  <h1 class="text-4xl font-semibold">Projects</h1>
  <p class="mt-3 text-muted">Case studies: the problem, what I did, and what came of it.</p>
  {
    categories.map((cat) => (
      <section class="mt-8">
        {cat && (
          <h2 class="border-b border-line pb-1 text-right font-sans text-2xl font-light text-muted/70">{cat}</h2>
        )}
        <ul class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {projects
            .filter((p) => (p.data.category ?? '') === cat)
            .map((p) => (
              <li>
                <a
                  href={`/projects/${p.id}/`}
                  class="group flex h-full flex-col overflow-hidden rounded-lg border border-line bg-card shadow-sm transition hover:-translate-y-1 hover:border-accent hover:shadow-md"
                >
                  {p.data.image ? (
                    <Image src={p.data.image} alt="" width={640} height={360} fit="cover" class="aspect-video w-full object-cover" />
                  ) : (
                    <div class="hero-bg flex aspect-video w-full items-center justify-center bg-accent-soft font-serif text-4xl text-accent">
                      {p.data.title.charAt(0)}
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-4">
                    <h3 class="font-sans text-lg font-semibold leading-snug group-hover:text-accent">
                      {p.data.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed">{p.data.summary}</p>
                    <p class="mt-auto pt-4 text-xs text-muted">
                      {p.data.period} · {p.data.role}
                    </p>
                  </div>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Base>
