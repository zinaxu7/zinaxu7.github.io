---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { getSite } from '../lib/site';

const site = await getSite();

const pubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const years = [...new Set(pubs.map((p) => p.data.year))];
---

<Base title="Publications" description={`Publications by ${site.name}.`}>
  <h1 class="text-4xl font-semibold">Publications</h1>
  <p class="mt-3 text-muted">Papers in reverse chronological order. Click Abs or Bib under an entry to expand it.</p>
  {
    site.links.scholar && (
      <p class="mt-3 text-muted">
        A full list is also on{' '}
        <a href={site.links.scholar} class="text-accent underline">Google Scholar</a>.
      </p>
    )
  }
  {
    years.map((year) => (
      <section class="mt-8">
        <h2 class="border-b border-line pb-1 text-right font-sans text-3xl font-light text-muted/70">{year}</h2>
        <ul class="divide-y divide-line">
          {pubs.filter((p) => p.data.year === year).map((p) => <PubItem id={p.id} pub={p.data} />)}
        </ul>
      </section>
    ))
  }
</Base>
